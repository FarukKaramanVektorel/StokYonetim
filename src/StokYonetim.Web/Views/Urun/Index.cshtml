@model IEnumerable<StokYonetim.Application.DTOs.UrunDto>

@{
    ViewData["Title"] = "Ürün Listesi";
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ürün Listesi</h2>
    <a asp-action="Ekle" class="btn btn-primary">Yeni Ürün Ekle</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table>

            <thead>
                <tr>
                    <th>#</th>
                    <th>Barkod</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Alış Fiyatı</th>
                    <th>Satış Fiyatı</th>
                    <th>Birim</th>
                    <th>İşlemler</th>

                </tr>
            </thead>
            <tbody>
                @if(Model!=null&&Model.Any())
                {
                    foreach(var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Barkod</td>
                            <td>@item.Ad</td>
                            <td>@item.KategoriAdi</td>
                            <td>@item.AlisFiyati</td>
                            <td>@item.SatisFiyati</td>
                            <td>@item.Birim</td>
                            <td>
                                <button class="btn btn-group-sm btn-warning">Düzenle</button>
                                <button class="btn btn-group-sm btn-danger">Sil</button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">Henüz ürün eklenmemiş</td>
                    </tr>
                }

            </tbody>
        </table>

    </div>
</div>
